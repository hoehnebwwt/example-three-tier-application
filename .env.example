# Environment Variables Template
# Copy this file to .env and adjust values for your local environment
# For Docker Compose, these are set in docker-compose.yml

# Database connection string
# Format: postgres://username:password@host:port/database
# Default for local development: postgres://app:app@localhost:5432/app
# For Docker Compose: postgres://app:app@postgres:5432/app
DATABASE_URL=postgres://app:app@localhost:5432/app

# API server port
# The Express API listens on this port
# Default: 3001
PORT=3001

# Web server port
# The Next.js frontend listens on this port
# Default: 3000
# Note: This is typically set in the web service, not globally
# PORT=3000

# API URL for frontend
# The frontend uses this URL to make requests to the API
# For local Docker Compose: http://api:3001 (internal Docker network)
# For local development: http://localhost:3001
# For production: https://api.example.com
API_URL=http://api:3001
